.:53 {
    # Log all DNS queries
    log
    
    # Handle mbyte.fr domains
    template IN A mbyte.fr {
        match "^(.+\\.)?mbyte\\.fr\\.$"
        answer "{{ .Name }} 60 IN A 10.11.127.60"
        fallthrough
    }
    
    # Handle s.mbyte.fr subdomains (stores)
    template IN A s.mbyte.fr {
        match "^(.+)\\.s\\.mbyte\\.fr\\.$"
        answer "{{ .Name }} 60 IN A 10.11.127.60"
        fallthrough
    }
    
    # Forward all other queries to Google DNS
    forward . 8.8.8.8 8.8.4.4
    
    # Cache responses
    cache 30
    
    # Return NXDOMAIN for non-existent domains quickly
    errors
}
